<!DOCTYPE html>
<html>

<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
<meta charset="UTF-8">
<title>BabelHeim</title>
<meta name="description" content="石橋駅徒歩3分のシーシャカフェバー
      Open:<%= @shop_config.open_hour %>〜<%= @shop_config.close_hour %> 定休日:不定休 喫煙可です
      カフェやバーのみのご利用もお待ちしています">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<link rel="canonical" href="https://babelheim.com">
<!-- OGP設定 -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://babelheim.com" />
<meta property="og:image" content="assets/logo.png" />
<meta property="og:title" content="BabelHeim" />
<meta property="og:description" content="石橋駅徒歩3分のシーシャカフェバー
      Open:<%= @shop_config.open_hour %>〜<%= @shop_config.close_hour %> 定休日:不定休 喫煙可です
      カフェやバーのみのご利用もお待ちしています" />
<meta property="og:site_name" content="BabelHeim" />
<%= render "shared/site_assets" %>
</head>

<body>
<div class="bh">

<%= render "shared/site_header" %>

<!-- トップ -->
<section class="bh-hero" id="TOP">
  <div class="container">
    <%= image_tag "babel-logo.jpg", alt: "Babel Heim shisha cafe and bar", class: "bh-hero__logo" %>
    <p class="bh-hero__lead">石橋阪大前駅 徒歩3分のシーシャカフェバー</p>
    <div class="bh-hero__status">
      <% if @is_open %>
        <span class="bh-badge bh-badge--open">本日営業</span>
        <span><%= @shop_config.open_hour %> – <%= @shop_config.close_hour %></span>
      <% else %>
        <span class="bh-badge bh-badge--closed">本日休業</span>
        <span>営業日はカレンダーをご確認ください</span>
      <% end %>
    </div>
    <div class="bh-hero__actions">
      <a href="#ATTENDING" class="bh-btn bh-btn--primary">空席を見る</a>
      <a href="#ACCESS" class="bh-btn bh-btn--ghost">アクセス</a>
    </div>
  </div>
</section>

<!-- 混雑状況 -->
<section class="bh-section bh-section--dark" id="ATTENDING">
  <div class="container">
    <p class="bh-eyebrow">Seats</p>
    <h2 class="bh-title">Attending</h2>
    <% if @is_open %>
      <p class="bh-text">店舗の座席情報がリアルタイムで反映されます。</p>
      <ul class="bh-legend">
        <li><i class="fas fa-user bh-legend__free"></i> 空席</li>
        <li><i class="fas fa-user-slash bh-legend__used"></i> 使用中</li>
      </ul>
      <% if admin_signed_in? %>
        <div class="text-center mb-4">
          <%= link_to "開始（全席を空席にする）", all_seats_path, method: :put, class: "bh-btn bh-btn--primary" %>
        </div>
      <% end %>
      <div class="bh-floor">
        <div class="relative_tenpo">
          <%= image_tag "floor2024.png", class: "tenpo-image", alt: "店内の座席配置図" %>
          <% @seats.first(14).each do |seat| %>
            <%= render partial: 'seats/seat', locals: { seat: seat } %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="bh-text">
        本日は休業日です。<br>
        最新の営業日情報はCalendarをご確認ください。<br>
        営業日には店舗の座席情報がリアルタイムで反映されます。
      </p>
    <% end %>
  </div>
</section>

<!-- カレンダー -->
<section class="bh-section" id="CALENDAR">
  <div class="container">
    <p class="bh-eyebrow">Schedule</p>
    <h2 class="bh-title">Calendar</h2>
    <p class="bh-text">
      今月の休業日情報です。<span class="bh-chip">定休日：不定休</span>
    </p>
    <div class="bh-card bh-calendar">
      <%= month_calendar events: @holidays do |date, holidays| %>
        <span class="bh-calendar__day"><%= date.day %></span>
        <% holidays.each do |holiday| %>
          <div class="bh-calendar__holiday"><%= holiday.title %></div>
        <% end %>
        <% @shifts.select { |s| s.start_time.to_date == date }.each do |shift| %>
          <div class="bh-calendar__staff"><%= shift.staff.name %></div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- 店内紹介 -->
<section class="bh-section bh-section--cream" id="ABOUT">
  <div class="container">
    <p class="bh-eyebrow">About</p>
    <h2 class="bh-title">About</h2>
    <ul class="bh-facts">
      <li><span>Open</span><%= @shop_config.open_hour %>〜<%= @shop_config.close_hour %></li>
      <li><span>定休日</span>不定休</li>
      <li><span>チャージ</span>なし</li>
      <li><span>喫煙</span>可</li>
    </ul>
    <p class="bh-text">カフェやバーのみのご利用もお待ちしています。</p>

    <div class="bh-feature">
      <%= image_tag "shisha2.jpg", class: "bh-feature__img", alt: "シーシャ" %>
      <div class="bh-feature__body">
        <h3>シーシャ</h3>
        <p class="bh-price">¥2,100 <small>/ 1本</small></p>
        <p>30種類以上のフレーバーを用意しております。<br>ご提供まで15〜30分のお時間を頂きます。</p>
      </div>
    </div>
    <div class="bh-feature bh-feature--reverse">
      <%= image_tag "prohibits.jpg", class: "bh-feature__img", alt: "持ち込みについて" %>
      <div class="bh-feature__body">
        <h3>食べ物持ち込みOK！</h3>
        <p>皆様がシーシャの香りを楽しんでいただけるよう、匂いの強い食べ物はご遠慮ください。<br>また、カフェバーなので飲み物のお持ち込みはご遠慮ください。</p>
      </div>
    </div>
  </div>
</section>

<!-- 座席紹介 -->
<section class="bh-section" id="SPACE">
  <div class="container">
    <p class="bh-eyebrow">Space</p>
    <h2 class="bh-title">Space</h2>
    <div class="bh-grid">
      <figure class="bh-photo">
        <%= image_tag "open-seat.jpg", alt: "カウンター席" %>
        <figcaption>カウンター</figcaption>
      </figure>
      <figure class="bh-photo">
        <%= image_tag "sofa-seat.jpg", alt: "ソファ席" %>
        <figcaption>ソファ</figcaption>
      </figure>
      <figure class="bh-photo">
        <%= image_tag "pair-seat.jpg", alt: "フラット席" %>
        <figcaption>フラット</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- お知らせ -->
<% if @shop_config.is_show_news? || admin_signed_in? %>
  <section class="bh-section bh-section--cream" id="NEWS">
    <div class="container">
      <p class="bh-eyebrow">Information</p>
      <h2 class="bh-title">News</h2>
      <% if admin_signed_in? %>
        <p class="bh-text">
          現在の状態：<%= @shop_config.is_show_news? ? "表示中" : "非表示中" %>
          （<%= link_to 'Newsの表示状態を変更する', update_is_show_news_path %>）
        </p>
      <% end %>
      <div class="bh-news">
        <% @news.each do |new| %>
          <article class="bh-card bh-news__item">
            <time><%= new.created_at.strftime('%Y/%m/%d') %></time>
            <h3><%= new.title %></h3>
            <p><%= new.content %></p>
          </article>
        <% end %>
      </div>
      <div class="text-center mt-4">
        <%= link_to "もっとみる", news_index_path, class: "bh-btn bh-btn--ghost-dark" %>
      </div>
    </div>
  </section>
<% end %>

<!-- アクセス -->
<section class="bh-section bh-section--dark" id="ACCESS">
  <div class="container">
    <p class="bh-eyebrow">Access</p>
    <h2 class="bh-title">Access</h2>
    <div class="bh-access">
      <dl class="bh-access__info">
        <dt>店舗名</dt>
        <dd>Babel Heim</dd>
        <dt>住所</dt>
        <dd>大阪府池田市石橋1-23-2</dd>
        <dt>アクセス</dt>
        <dd>阪急宝塚線「石橋阪大前」西改札口 徒歩3分</dd>
        <dt>営業時間</dt>
        <dd><%= @shop_config.open_hour %> – <%= @shop_config.close_hour %><br><small>シーシャ L.O. <%= @shop_config.last_order_hour %></small></dd>
        <dt>定休日</dt>
        <dd>不定休</dd>
      </dl>
      <div class="bh-access__map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3275.958986723292!2d135.4406222152352!3d34.80697368040731!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6000f16d91f89ee3%3A0x44a9bf017518399d!2sbabelheim!5e0!3m2!1sja!2sjp!4v1659173127943!5m2!1sja!2sjp" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Babel Heim の地図"></iframe>
      </div>
    </div>
  </div>
</section>

<%= render "shared/site_footer" %>

</div>
</body>
</html>
