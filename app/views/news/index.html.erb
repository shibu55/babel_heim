<!DOCTYPE html>
<html>

<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
<meta charset="UTF-8">
<title>News | BabelHeim</title>
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<%= render "shared/site_assets" %>
</head>

<body>
<div class="bh">

<%= render "shared/site_header" %>

<section class="bh-section bh-section--cream bh-page">
  <div class="container">
    <p class="bh-eyebrow">Information</p>
    <h1 class="bh-title">News</h1>
    <p class="bh-text">Babel Heim からのお知らせです。</p>

    <% if admin_signed_in? %>
      <div class="text-center mb-4">
        <%= link_to "Newsを追加する", new_news_path, class: "bh-btn bh-btn--primary" %>
      </div>
    <% end %>

    <% if @news.any? %>
      <div class="bh-newslist">
        <% @news.each do |news| %>
          <article class="bh-card bh-newslist__item">
            <time datetime="<%= news.created_at.to_date.iso8601 %>"><%= news.created_at.strftime('%Y.%m.%d') %></time>
            <div>
              <h2><%= news.title %></h2>
              <p><%= news.content %></p>
              <% if admin_signed_in? %>
                <div class="bh-newslist__admin">
                  <%= link_to "編集", edit_news_path(news) %>
                  <%= link_to "削除", news_path(news), method: :delete, data: { confirm: "「#{news.title}」を削除しますか？" } %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="bh-text">現在お知らせはありません。</p>
    <% end %>

    <div class="text-center mt-5">
      <%= link_to "トップに戻る", root_path, class: "bh-btn bh-btn--ghost-dark" %>
    </div>
  </div>
</section>

<%= render "shared/site_footer" %>

</div>
</body>
</html>
