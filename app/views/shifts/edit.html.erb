<% content_for :title, "シフト編集" %>

<div class="adm-head">
  <h1>シフト編集</h1>
</div>

<section class="adm-card adm-card--narrow">
  <%= form_with model: @shift, local: true do |form| %>
    <% if @shift.errors.any? %>
      <ul class="adm-errors">
        <% @shift.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
    <div class="adm-field">
      <%= form.label :staff_id, "スタッフ" %>
      <%= form.select :staff_id, options_from_collection_for_select(@staffs, :id, :name, @shift.staff_id), { prompt: "選択してください" } %>
    </div>
    <div class="adm-field">
      <%= form.label :start_time, "出勤日" %>
      <%= form.date_field :start_time %>
    </div>
    <div class="adm-actions">
      <%= form.submit "更新する" %>
      <%= link_to "キャンセル", shifts_path, class: "adm-btn adm-btn--ghost" %>
    </div>
  <% end %>
</section>
