<% content_for :title, "シフト管理" %>

<div class="adm-head">
  <div>
    <h1>シフト管理</h1>
    <p>登録したシフトはトップページのカレンダーにスタッフ名で表示されます。</p>
  </div>
  <%= link_to "スタッフを管理する", staffs_path, class: "adm-btn adm-btn--ghost" %>
</div>

<section class="adm-card" style="margin-bottom: 1.25rem">
  <h2>シフトの登録</h2>
  <%= form_with(model: @shift || Shift.new, local: true) do |form| %>
    <% if @shift&.errors&.any? %>
      <ul class="adm-errors">
        <% @shift.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
    <div class="adm-row">
      <div class="adm-field">
        <%= form.label :staff_id, "スタッフ" %>
        <%= form.select :staff_id, options_from_collection_for_select(@staffs, :id, :name), { prompt: "選択してください" } %>
      </div>
      <div class="adm-field">
        <%= form.label :start_time, "出勤日" %>
        <%= form.date_field :start_time %>
      </div>
    </div>
    <div class="adm-actions" style="margin-top: 0">
      <%= form.submit "追加する" %>
    </div>
  <% end %>
</section>

<section class="adm-card adm-calendar">
  <%= month_calendar events: @holidays do |date, holidays| %>
    <span class="adm-cal-day"><%= date.day %></span>
    <% if holidays.any? %>
      <div class="adm-cal-item"><span class="adm-tag">休業日</span></div>
    <% end %>
    <% @shifts.select { |shift| shift.start_time.to_date == date }.each do |shift| %>
      <div class="adm-cal-item">
        <span class="adm-tag adm-tag--staff"><%= shift.staff.name %></span>
        <div class="adm-mini">
          <%= link_to "編集", edit_shift_path(shift) %>
          <%= link_to "削除", shift_path(shift), method: :delete, data: { confirm: "#{shift.staff.name} さんの #{date.month}/#{date.day} のシフトを削除しますか？" }, class: "adm-link-danger" %>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
