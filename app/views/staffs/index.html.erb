<% content_for :title, "スタッフ管理" %>

<div class="adm-head">
  <h1>スタッフ管理</h1>
  <%= link_to "スタッフを追加", new_staff_path, class: "adm-btn" %>
</div>

<section class="adm-card adm-card--narrow">
  <% if @staffs.any? %>
    <table class="adm-table">
      <thead>
        <tr>
          <th>名前</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @staffs.each do |staff| %>
          <tr>
            <td><%= staff.name %></td>
            <td>
              <%= link_to "編集", edit_staff_path(staff) %>
              <%= link_to "削除", staff_path(staff), method: :delete, data: { confirm: "#{staff.name} さんを削除しますか？" }, class: "adm-link-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="adm-empty">まだスタッフが登録されていません。</p>
  <% end %>
</section>
