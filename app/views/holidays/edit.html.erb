<% content_for :title, "休日の編集" %>

<div class="adm-head">
  <h1>休日の編集</h1>
</div>

<section class="adm-card adm-card--narrow">
  <%= form_with(model: @holiday, local: true) do |form| %>
    <div class="adm-field">
      <%= form.label :title, "種類" %>
      <%= form.text_field :title %>
    </div>
    <div class="adm-field">
      <%= form.label :start_time, "日付" %>
      <%= form.date_field :start_time %>
    </div>
    <div class="adm-actions">
      <%= form.submit "更新する" %>
      <%= link_to "キャンセル", new_holiday_path, class: "adm-btn adm-btn--ghost" %>
    </div>
  <% end %>
</section>
