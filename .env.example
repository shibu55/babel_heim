# cp .env.example .env して値を埋める。.env はコミットしない。
# 本番では GitHub Actions のデプロイが SSM Parameter Store (/babelheim/*) から .env を生成する。
SECRET_KEY_BASE=   # ローカルは openssl rand -hex 64 などで生成
DB_PASSWORD=

# --- ローカル確認用 ---
FORCE_SSL=false
HTTP_PORT=3000
HTTPS_PORT=3443

# --- 本番用 ---
# FORCE_SSL=true
# TLS_DOMAIN=babelheim.com
# WEB_IMAGE=<ECR のイメージ URI>
# BACKUP_BUCKET=<バックアップ用 S3 バケット名>
